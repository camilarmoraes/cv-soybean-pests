# --- Dataset ---
# Caminho raiz do dataset dividido (contendo train/, val/, test/)
DATASET_PATH=/caminho/para/DADOS-DIVIDIDOS

# Caminho das bases originais (antes do split)
RAW_DATASET_PATH=/caminho/para/bases-usadas

# Caminho de saída para datasets processados
OUTPUT_DATASET_PATH=/caminho/para/DATASET-SAIDA

# --- Modelos Pré-treinados---
RESNET101_PRETRAINED=/caminho/para/models/ResNet_101_ImageNet_plant-model-84.pth
DENSENET201_PRETRAINED=/caminho/para/models/densenet201-model-95.pth
VGG19_PRETRAINED=/caminho/para/models/VggNet19-model-96.pth
MOBILENETV3_PRETRAINED=/caminho/para/models/mobilenet_v3_large-model-84.pth

# --- Modelos Treinados (saída do treinamento) ---
TRAINED_MODEL_PATH=/caminho/para/modelos-treinados/best_model.pt

# --- Ortomosaico ---
ORTHOMOSAIC_PATH=/caminho/para/ortomosaico.tif
ORTHOMOSAIC_OUTPUT_DIR=/caminho/para/saida-inferencia

# --- Imagens de teste avulsas (para substituição de tiles) ---
AVULSA_IMAGES_PATH=/caminho/para/imagens-avulsas

# --- Saídas ---
RESULTS_DIR=./results
CHECKPOINT_DIR=./checkpoints
